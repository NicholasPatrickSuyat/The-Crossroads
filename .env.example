# Copy to `.env.local` (Next.js) and/or `.dev.vars` (Wrangler / OpenNext preview).
# Never commit real API keys. Configure production secrets in Cloudflare later.

# Resend API key (https://resend.com) — SERVER ONLY
RESEND_API_KEY=

# Verified Resend sender, e.g. Project X <onboarding@resend.dev> or your domain
LEAD_FROM_EMAIL=

# Inquiry inbox (defaults in code to Nicholaspatricksuyat@gmail.com if unset)
LEAD_TO_EMAIL=Nicholaspatricksuyat@gmail.com
